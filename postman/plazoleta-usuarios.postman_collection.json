{
  "info": {
    "name": "Plazoleta - Usuarios",
    "description": "Pruebas del microservicio plazoleta-usuarios.\n\nOrden de ejecucion: 01 Autenticacion -> 02 HU-1 -> 03 Seguridad (usar el Collection Runner).\nRequiere el servicio en ejecucion (mvn spring-boot:run) y PostgreSQL (docker compose up -d).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Autenticacion",
      "description": "Login y obtencion del JWT. Ejecutar \"Login ADMIN\" antes de las pruebas de la HU-1.",
      "item": [
        {
          "name": "Login ADMIN (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesion con el ADMIN semilla y guarda el token en la variable adminToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve un JWT\", () => {",
                  "    const token = pm.response.json().token;",
                  "    pm.expect(token).to.be.a(\"string\").and.to.have.length.above(20);",
                  "    pm.collectionVariables.set(\"adminToken\", token);",
                  "});",
                  "pm.test(\"El token contiene rol ADMIN\", () => {",
                  "    const payload = JSON.parse(require(\"atob\")(pm.collectionVariables.get(\"adminToken\").split(\".\")[1]));",
                  "    pm.expect(payload.role).to.eql(\"ADMIN\");",
                  "});"
                ]
              }
            }
          ]
        },
