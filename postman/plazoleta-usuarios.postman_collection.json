        {
          "name": "Menor de edad (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "owner"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"documentNumber\": \"{{randomDocument}}\",\n  \"phone\": \"+573005698325\",\n  \"birthDate\": \"{{birthDateUnderage}}\",\n  \"email\": \"{{randomEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = (n) => String(n).padStart(2, \"0\");",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 1);",
                  "// Cumple 18 manana: todavia es menor de edad",
                  "pm.collectionVariables.set(\"birthDateUnderage\", (d.getFullYear() - 18) + \"-\" + pad(d.getMonth() + 1) + \"-\" + pad(d.getDate()));",
                  "pm.collectionVariables.set(\"randomDocument\", Date.now().toString().slice(-8));",
                  "pm.collectionVariables.set(\"randomEmail\", \"menor_\" + Date.now() + \"@correo.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Respuesta con formato de error estandar\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"status\", 400);",
                  "    pm.expect(body).to.have.property(\"message\");",
                  "    pm.expect(body).to.have.property(\"timestamp\");",
                  "});",
