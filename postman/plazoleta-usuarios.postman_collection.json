    {
      "name": "02 - HU-1 Crear propietario",
      "description": "POST /users/owner. Requiere token de ADMIN (se hereda de la coleccion: {{adminToken}}).",
      "item": [
        {
          "name": "Crear propietario (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "owner"
              ]
            },
            "description": "Genera correo y documento unicos en cada ejecucion para poder repetir la coleccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"documentNumber\": \"{{ownerDocument}}\",\n  \"phone\": \"+573005698325\",\n  \"birthDate\": \"1990-05-20\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = Date.now().toString();",
                  "pm.collectionVariables.set(\"ownerDocument\", unique.slice(-10));",
                  "pm.collectionVariables.set(\"ownerEmail\", \"propietario_\" + unique + \"@correo.com\");",
                  "pm.collectionVariables.set(\"ownerPassword\", \"Clave123*\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"El usuario queda con rol OWNER\", () => pm.expect(body.role).to.eql(\"OWNER\"));",
                  "pm.test(\"Devuelve los datos enviados\", () => {",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"ownerEmail\"));",
                  "    pm.expect(body.documentNumber).to.eql(pm.collectionVariables.get(\"ownerDocument\"));",
                  "    pm.expect(body.phone).to.eql(\"+573005698325\");",
                  "});",
                  "pm.test(\"No expone la contrasena\", () => pm.expect(body).to.not.have.property(\"password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear propietario que cumple 18 hoy (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "owner"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"documentNumber\": \"{{edgeDocument}}\",\n  \"phone\": \"3001234567\",\n  \"birthDate\": \"{{birthDate18Today}}\",\n  \"email\": \"{{edgeEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = (n) => String(n).padStart(2, \"0\");",
                  "const d = new Date();",
                  "pm.collectionVariables.set(\"birthDate18Today\", (d.getFullYear() - 18) + \"-\" + pad(d.getMonth() + 1) + \"-\" + pad(d.getDate()));",
                  "const unique = Date.now().toString();",
                  "pm.collectionVariables.set(\"edgeDocument\", unique.slice(-9));",
                  "pm.collectionVariables.set(\"edgeEmail\", \"borde_\" + unique + \"@correo.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Rol OWNER\", () => pm.expect(pm.response.json().role).to.eql(\"OWNER\"));"
                ]
              }
            }
          ]
        },
